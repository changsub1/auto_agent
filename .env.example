DISCORD_BOT_TOKEN=replace_with_your_discord_bot_token
DISCORD_GUILD_ID=replace_with_your_test_server_id
# DISCORD_ALLOWED_CHANNEL_ID=optional_channel_id
# DISCORD_ALLOWED_USER_IDS=optional_user_id_1,optional_user_id_2
# PLANNER_A_CODEX_HOME=C:\Users\USER\.codex_planner_a
# PLANNER_B_CODEX_HOME=C:\Users\USER\.codex_planner_b
# ARCHITECT_CODEX_HOME=C:\Users\USER\.codex_architect
# SCAFFOLD_CODEX_HOME=C:\Users\USER\.codex_developer
# DEVELOPER_CODEX_HOME=C:\Users\USER\.codex_developer
# INTEGRATOR_CODEX_HOME=C:\Users\USER\.codex_developer
# CODE_AGENT_CODEX_HOMES=C:\Users\USER\.codex_developer_1,C:\Users\USER\.codex_developer_2
# CODE_AGENT_COUNT=2
# QA_AGENT_CODEX_HOMES=C:\Users\USER\.codex_qa
# QA_AGENT_COUNT=1
# ROUTING_MODE=balanced
# REFERENCE_PACK_ENABLED=1
# PLANNER_A_REFERENCE=
# PLANNER_B_REFERENCE=
# CODE_AGENT_REFERENCE=karpathy/code_agent
# INTEGRATOR_REFERENCE=karpathy/integrator
# QA_AGENT_REFERENCE=
# CODEX_MODEL=gpt-5.4
# CODEX_REASONING_EFFORT=medium
MAX_FIX_ITERATIONS=1
CODEX_TIMEOUT_SECONDS=900
# LOCAL_API_HOST=127.0.0.1
# LOCAL_API_PORT=8765
# Discord controls runs through this local API. Defaults to LOCAL_API_HOST/PORT.
# DISCORD_LOCAL_API_BASE_URL=http://127.0.0.1:8765
# Tauri sidecar overrides. Set these in the shell before pnpm tauri:dev/build.
# ORCHESTRA_REPO_ROOT=D:\curs\auto\multi_codex_dev_mvp
# ORCHESTRA_PYTHON=D:\curs\auto\multi_codex_dev_mvp\.venv\Scripts\python.exe
# Windows child Codex calls default to elevated for workspace-write. Override only if needed.
# CODEX_CHILD_WINDOWS_SANDBOX=elevated
# Default is presentation-friendly slim artifacts. Set to 1 only when diagnosing runner internals.
# ORCHESTRA_DEBUG_ARTIFACTS=0
EXECUTABLE_QA_ENABLED=1
EXECUTABLE_QA_TIMEOUT_SECONDS=90
# Keep disabled unless you trust generated .bat/.cmd launchers.
EXECUTABLE_QA_ALLOW_LOCAL_COMMANDS=0
